          ]
        }
      ],
      "source": [
        "x = torch.rand((4, 4, 8))  # (B, N, dim) Made into a small matrix for easy viewing\n",
        "patch_shuffle = PatchShuffle(ratio=0.75)\n",
        "in_patches, forward_idx, backward_idx = patch_shuffle(x)\n",
        "\n",
        "print(f\"original data: shape {x.shape} \\n {x}\")\n",
